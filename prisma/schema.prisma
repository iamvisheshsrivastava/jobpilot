generator client {
  provider = "prisma-client-js"
}

// Local dev: SQLite (no setup needed)
// Production: change provider to "postgresql" and remove @db.Text / @db.Date annotations
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// SQLite doesn't support native enums — stored as String with app-level validation
// When migrating to PostgreSQL, uncomment the enum blocks below and add them back to fields

// enum JobStatus  { IN_PROGRESS APPLIED INTERVIEW OFFER LOOK_AGAIN REJECTED NOT_SUITABLE EXPIRED_FILLED }
// enum JobPriority { SUPER_HIGH HIGH MEDIUM LOW }
// enum LlmProvider { GROQ OPENROUTER OPENAI ANTHROPIC GEMINI }

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String   @map("password_hash")
  // Bumped whenever the password changes (or an admin/user wants to revoke
  // all outstanding extension tokens). Embedded in extension tokens as `tv`
  // and checked in verifyExtToken() - issue #15.
  tokenVersion   Int      @default(0) @map("token_version")
  telegramChatId String?  @map("telegram_chat_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  categories        Category[]
  apiKeys           ApiKey[]
  profile           UserProfile?
  resumeVersions    ResumeVersion[]
  gmailToken        GmailToken?
  notifications     Notification[]
  integrationEvents IntegrationEvent[]

  @@map("users")
}

model TelegramLinkToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("telegram_link_tokens")
}

model UserProfile {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  summary        String?
  cvText         String?  @map("cv_text")
  experience     String? // JSON array of ExperienceEntry
  education      String? // JSON array of EducationEntry
  skills         String? // JSON array of strings
  languages      String? // JSON array of LanguageEntry
  certifications String? // JSON array of strings
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model ApiKey {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  provider     String // "GROQ" | "OPENROUTER" or any LlmProvider
  encryptedKey String   @map("encrypted_key")
  modelName    String?  @map("model_name")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("api_keys")
}

model Category {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  name         String
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@unique([userId, name])
  @@map("categories")
}

model Job {
  id               String    @id @default(cuid())
  categoryId       String    @map("category_id")
  jobNumber        Int       @map("job_number")
  title            String
  company          String?
  link             String?
  status           String    @default("IN_PROGRESS") // JobStatus enum values
  priority         String    @default("MEDIUM") // JobPriority enum values
  comments         String?
  deadline         DateTime?
  dateAdded        DateTime  @default(now()) @map("date_added")
  starred          Boolean   @default(false)
  duplicateGroupId String?   @map("duplicate_group_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Kanban / extended fields
  recruiterName     String? @map("recruiter_name")
  recruiterEmail    String? @map("recruiter_email")
  recruiterLinkedIn String? @map("recruiter_linkedin")
  resumeUsed        String? @map("resume_used")
  applicationNotes  String? @map("application_notes")
  resumeVersionId   String? @map("resume_version_id")

  // AI-computed suitability score (0-100), persisted so it survives a page
  // reload instead of only living in the suitability-check response (#21).
  matchScore   Int?      @map("match_score")
  matchVerdict String?   @map("match_verdict")
  matchedAt    DateTime? @map("matched_at")

  // Interview scheduling (#20)
  interviewDate           DateTime? @map("interview_date")
  interviewType           String?   @map("interview_type") // e.g. Phone, Video, Onsite, Technical
  interviewLocation       String?   @map("interview_location") // address, meeting link, or dial-in info
  // Set once the 24h-ahead reminder cron (app/api/cron/interview-reminders)
  // has fired for the current interviewDate, so re-running the cron (or a
  // concurrent run) doesn't send duplicate Telegram pings / Notification rows.
  interviewReminderSentAt DateTime? @map("interview_reminder_sent_at")

  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  resumeVersion ResumeVersion? @relation("JobResume", fields: [resumeVersionId], references: [id])
  note          JobNote?
  history       JobHistory[]

  @@map("jobs")
}

model ResumeVersion {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  fileUrl   String?  @map("file_url")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[] @relation("JobResume")

  @@map("resume_versions")
}

model JobNote {
  id        String   @id @default(cuid())
  jobId     String   @unique @map("job_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_notes")
}

model JobHistory {
  id           String   @id @default(cuid())
  jobId        String   @map("job_id")
  fieldChanged String   @map("field_changed")
  oldValue     String?  @map("old_value")
  newValue     String?  @map("new_value")
  changedAt    DateTime @default(now()) @map("changed_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_history")
}

model GmailToken {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  email        String
  // Encrypted at rest with lib/crypto.ts (same AES-256-GCM helper already
  // used for user LLM API keys) - a refresh token grants long-lived inbox
  // access, so it shouldn't sit in the DB in plaintext.
  accessToken  String    @map("encrypted_access_token")
  refreshToken String    @map("encrypted_refresh_token")
  expiresAt    DateTime  @map("expires_at")
  lastSyncAt   DateTime? @map("last_sync_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gmail_tokens")
}

model Notification {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  type         String // REJECTION | INTERVIEW | OFFER | APPLICATION_CONFIRMATION | OTHER
  title        String
  body         String
  read         Boolean   @default(false)
  emailFrom    String?   @map("email_from")
  emailSubject String?   @map("email_subject")
  emailDate    DateTime? @map("email_date")
  // Scoped to (userId, gmailMsgId) rather than globally unique on gmailMsgId -
  // Gmail message IDs are only unique within one mailbox, so two different
  // users could otherwise never both get a notification for "the same"
  // msgId, and in principle collide (issue #23).
  gmailMsgId   String?   @map("gmail_msg_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gmailMsgId])
  @@map("notifications")
}

// Audit trail of integration connect/disconnect events, surfaced in
// Settings → Integrations (issue #7).
model IntegrationEvent {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  provider  String // GMAIL | TELEGRAM
  event     String // CONNECT | DISCONNECT
  detail    String? // e.g. the connected Gmail address
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("integration_events")
}
