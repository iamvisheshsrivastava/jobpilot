DATABASE_URL="postgresql://user:password@localhost:5432/jobpilot"

# Required for Prisma migrations (schema.prisma's directUrl). Use a direct,
# non-pooled connection string (e.g. bypass PgBouncer/Accelerate) — Prisma
# Migrate needs a direct connection even when DATABASE_URL goes through a pooler.
DIRECT_URL="postgresql://user:password@localhost:5432/jobpilot"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="64-character-hex-string-for-aes256"

# Optional: AUTH_SECRET is the v5 alias for NEXTAUTH_SECRET
AUTH_SECRET="generate-with-openssl-rand-base64-32"
